{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>sourcegraph/renovate-config",
    "customManagers:githubActionsVersions"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 4am"
    ]
  },
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchFileNames": [
        "build-requirements.txt"
      ],
      "groupName": "build requirements"
    },
    {
      "description": "First-party package, no cooldown",
      "matchPackageNames": [
        "src-py-lib"
      ],
      "minimumReleaseAge": null
    },
    {
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "<3.12"
    },
    {
      "matchPackageNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": false
    }
  ],
  "schedule": [
    "at any time"
  ]
}
