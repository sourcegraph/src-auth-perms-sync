{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>sourcegraph/renovate-config",
    "customManagers:githubActionsVersions",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "automerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "minimumReleaseAge": null
  },
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchFileNames": [
        "build-requirements.txt"
      ],
      "groupName": "build requirements"
    },
    {
      "description": "First-party package: no cooldown, its own pull request at any time",
      "matchPackageNames": [
        "src-py-lib"
      ],
      "minimumReleaseAge": null,
      "groupName": null,
      "schedule": [
        "at any time"
      ]
    },
    {
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "<3.12"
    },
    {
      "matchPackageNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": false
    }
  ],
  "platformAutomerge": false,
  "rangeStrategy": "replace"
}
